generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STAFF
  CLIENT
}

enum OrderStatus {
  PENDING     // Orçamento / Pedido recebido
  IN_ANALYSIS // Em análise técnica
  APPROVED    // Aprovado / Aguardando início
  IN_PROGRESS // Em desenvolvimento
  COMPLETED   // Entregue / Concluído
  CANCELED    // Cancelado
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  whatsapp     String?
  companyName  String?
  passwordHash String
  role         Role     @default(CLIENT)
  active       Boolean  @default(true)
  orders       Order[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model Service {
  id               String   @id @default(cuid())
  slug             String   @unique
  title            String
  shortDescription String   @db.Text
  badge            String?
  features         String[] // Suportado nativamente pelo PostgreSQL
  idealFor         String
  active           Boolean  @default(true)
  displayOrder     Int      @default(0)
  orders           Order[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("services")
}

model Order {
  id          String      @id @default(cuid())
  code        Int         @default(autoincrement()) // Número amigável do pedido (ex: #1001)
  status      OrderStatus @default(PENDING)
  details     String      @db.Text
  price       Decimal?    @db.Decimal(10, 2)
  notes       String?     @db.Text // Observações internas da equipe Atule
  
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  serviceId   String
  service     Service     @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([userId])
  @@index([serviceId])
  @@map("orders")
}